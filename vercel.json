{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/index?route=health" },
    { "source": "/api/feed", "destination": "/api/index?route=feed" },
    { "source": "/api/ledger", "destination": "/api/index?route=ledger" },
    { "source": "/api/snapshot", "destination": "/api/index?route=snapshot" },
    { "source": "/api/financials", "destination": "/api/index?route=financials" },
    { "source": "/api/alerts/config", "destination": "/api/index?route=alerts/config" },
    { "source": "/api/cron/daily", "destination": "/api/index?route=cron/daily" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "30 3 * * *" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,**/.venv/**,spike/**,build-history/**,.finn_cache/**,web/**,**/*.pdf}"
    }
  }
}
